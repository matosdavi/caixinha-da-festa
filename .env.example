# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# (o .env está no .gitignore: nunca vai para o GitHub)
# NUNCA cole aqui a connection string do Neon de produção: este arquivo vai para o GitHub.

# Ambiente: development | production
# Em production, DATABASE_URL e ADMIN_SENHA passam a ser obrigatórios.
APP_ENV=development

# Porta HTTP
PORT=8080

# Login do painel do organizador (/painel). Em produção: senha com 12+ caracteres.
# Senha vazia em desenvolvimento = uma senha temporária aparece no console.
ADMIN_USUARIO=organizador
ADMIN_SENHA=

# String de conexão do PostgreSQL. VAZIA = banco H2 em arquivo (./data), sem instalar nada.
# Recomendado para desenvolvimento: deixar vazio ou usar o PostgreSQL local, NUNCA o Neon de produção.
# PostgreSQL local do docker-compose.yml (porta 5434):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5434/caixinha?sslmode=disable
DATABASE_URL=
